# Copy to backend/.env for local development (not loaded when NODE_ENV=production).

# Express session signing secret
SESSION_SECRET=

# MongoDB connection string and database name
ATLAS_URI=mongodb://localhost:27017
MONGODB=softwar

# Google OAuth client (the redirect variable name is spelled GOOLGE in the code)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOLGE_REDIRECT_URL=http://localhost:3000/auth/google/callback

# SendGrid API key for outgoing mail (starts with SG.)
SENDGRID_API_KEY=

# Optional
# PORT=3000
# NODE_ENV=development
# In production, visitors are redirected to https unless the proxy in front says they already use it.
# Running without an https proxy (only for trying it out): FORCE_HTTPS=false
# FORCE_HTTPS=true
