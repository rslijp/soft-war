{
    "root": true,
    "env": {
        "browser": true,
        "node": true,
        "es2022": true
    },
    "extends": [
        "eslint:recommended"
    ],
    "rules": {
        "no-unused-vars": ["error", {"args": "none"}]
    },
    "parserOptions": {
        "ecmaVersion": "latest",
        "sourceType": "module"
    },
    "overrides": [
        {
            "files": ["spec/**/*.mjs"],
            "env": {
                "jasmine": true
            }
        }
    ]
}
